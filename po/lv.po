msgid "Syntax error in date field."
msgstr "Sintakses kļūda datuma laukā."

#: src/data/data-in.c:787
#, c-format
msgid "Day (%ld) must be between 1 and 31."
msgstr "Dienai (%ld) jābūt no 1 līdz 31."

#: src/data/data-in.c:836
msgid "Delimiter expected between fields in date."
msgstr "Starp datuma laukiem gaidīts atdalītājs."

#: src/data/data-in.c:910
msgid "Unrecognized month format.  Months may be specified as Arabic or Roman numerals or as at least 3 letters of their English names."
msgstr "Neatpazīts mēneša formāts. Mēnešus var norādīt kā arābu vai romiešu ciparus vai vismaz 3 burtus no to angļu nosaukumiem."

#: src/data/data-in.c:937
#, c-format
msgid "Year (%ld) must be between 1582 and 19999."
msgstr "Gadam (%ld) jābūt no 1582 līdz 19999."

#: src/data/data-in.c:948
#, c-format
msgid "Trailing garbage `%.*s' following date."
msgstr "Lieki dati `%.*s' pēc datuma."

#: src/data/data-in.c:962
msgid "Julian day must have exactly three digits."
msgstr "Jūliāna dienai jābūt tieši trīs cipariem."

#: src/data/data-in.c:964
#, c-format
msgid "Julian day (%ld) must be between 1 and 366."
msgstr "Jūliāna dienai (%ld) jābūt starp 1 un 366."

#: src/data/data-in.c:988
#, c-format
msgid "Quarter (%ld) must be between 1 and 4."
msgstr "Ceturksnim (%ld) jābūt starp 1 un 4."

#: src/data/data-in.c:1009
#, c-format
msgid "Week (%ld) must be between 1 and 53."
msgstr "Nedēļai (%ld) jābūt starp 1 un 53."

#: src/data/data-in.c:1021
msgid "Delimiter expected between fields in time."
msgstr "Starp laika laukiem gaidīts atdalītājs."

#: src/data/data-in.c:1041
#, c-format
msgid "Minute (%ld) must be between 0 and 59."
msgstr "Minūtei (%ld) jābūt starp 0 un 59."

#: src/data/data-in.c:1079
msgid "Unrecognized weekday name.  At least the first two letters of an English weekday name must be specified."
msgstr "Neatpazīts nedēļas dienas nosaukums. Jānorāda vismaz pirmie divi angļu valodas nedēļas dienas nosaukuma burti."

#: src/data/data-in.c:1214
#, c-format
msgid "`%c' expected in date field."
msgstr "Datuma laukā gaidīts `%c'."

#: src/data/data-out.c:585
#, c-format
msgid "Weekday number %f is not between 1 and 7."
msgstr "Nedēļas dienas numurs %f nav starp 1 un 7."

#: src/data/data-out.c:610
#, c-format
msgid "Month number %f is not between 1 and 12."
msgstr "Mēneša numurs %f nav starp 1 un 12."

