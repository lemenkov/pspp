msgid "All characters in field must be digits."
msgstr "Visām lauka rakstzīmēm jābūt cipariem."

#: src/data/data-in.c:449
msgid "Unrecognized character in field."
msgstr "Laukā ir neatpazīta rakstzīme."

#: src/data/data-in.c:470 src/data/data-in.c:733
msgid "Field must have even length."
msgstr "Laukam jābūt ar pāra garumu."

#: src/data/data-in.c:472 src/data/data-in.c:736
msgid "Field must contain only hex digits."
msgstr "Laukā jābūt tikai heksadecimāliem cipariem."

#: src/data/data-in.c:548
msgid "Invalid zoned decimal syntax."
msgstr "Nederīga zonētā decimālskaitļa sintakse."

